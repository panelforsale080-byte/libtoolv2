<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="#FF101014">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="LibTool V2"
        android:textColor="#FFFFFFFF"
        android:textSize="22sp"
        android:textStyle="bold"/>

    <TextView
        android:id="@+id/statusText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="conRentV1 source APK. Enter PID, then Connect."
        android:textColor="#FF9E9E9E"
        android:paddingTop="8dp"
        android:paddingBottom="16dp"/>

    <EditText
        android:id="@+id/pidInput"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="48dp"
        android:hint="Manual PID"
        android:inputType="number"
        android:singleLine="true"
        android:textColor="#FFFFFFFF"
        android:textColorHint="#FF888888"/>

    <Button
        android:id="@+id/btnConnect"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Connect"/>
</LinearLayout>
